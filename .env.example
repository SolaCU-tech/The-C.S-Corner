# Copy this file to .env for local development (optional — the app
# works with zero configuration locally, using SQLite and local file
# storage automatically). In production (Render), set these as real
# environment variables in the dashboard instead of using a .env file.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "True" for local development, "False" in production.
DEBUG=True

# Extra allowed hostnames, comma-separated (Render's own .onrender.com
# hostname is added automatically — you don't need to list it here).
DJANGO_ALLOWED_HOSTS=

# Postgres connection string, e.g. from Neon. Leave blank locally to
# use SQLite automatically.
DATABASE_URL=

# From your Cloudinary dashboard (Account Details -> API Environment
# variable). Leave blank locally to save uploads to the local media/
# folder automatically.
CLOUDINARY_URL=
